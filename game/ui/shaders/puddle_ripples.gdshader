shader_type canvas_item;
render_mode blend_mix;
// Краплі дощу, що падають у намальовані калюжі головного меню.
//
// Що робить: у місцях, де маска (assets/ui/puddle_mask.png) каже «вода»,
// рахує нахил водяної поверхні від кілець, що розходяться від кожної краплі,
// і підсвічує та затінює калюжу за цим нахилом. Схил, повернутий до неба,
// ловить світло; протилежний темніє — саме ця пара світло/тінь і читається
// оком як коло на воді.
//
// Знято з фотореференсів дощу по калюжах (Commons, «Rain on a puddle in
// Tuntorp»), і саме тому тут те, що є:
//   * одна крапля дає ЦУГ із кількох кілець, а не одне — короткі капілярні
//     хвилі біжать швидше за довгі й розкладаються в пачку концентричних смуг
//     (ring_count / train_falloff);
//   * кільця — ЕЛІПСИ, сплюснуті по вертикалі: земля йде від камери під
//     кутом, коло на ній проєктується в еліпс, і що далі — то плоскіший
//     (squash_far/squash_near);
//   * краплі різного калібру, інакше виходить візерунок у горошок;
//   * у момент удару — коротка яскрава цятка сплеску.
//
// Перспектива береться з РЯДКА КОМІРКИ, у якій народилась крапля, а не з
// пікселя, що малюється. Це принципово: якби кожен піксель брав власну
// глибину, сусідні пікселі порахували б різну форму того самого кільця і воно
// б розповзлось. Рядок комірки — спільне для всього кільця число.
//
// Чого тут НЕМАЄ і чому: спершу брижі заломлювали кадр під собою через
// hint_screen_texture (фізично найчесніший шлях). Виміряно на скріншотах:
// заломлення давало p95 = 5 одиниць з 255 проти 21 у всього ефекту, а на
// великій амплітуді лише сипало темними цятками в центрах кілець — бо
// намальована калюжа майже рівна за тоном, і викривляти в ній нічого. Ціна ж
// була повнокадрова копія бекбуфера ЩОКАДРУ на телефоні. Прибрано.

uniform sampler2D puddle_mask : filter_linear, repeat_disable;

// Пропорції фонової картини (menu_background.jpg). Потрібні, щоб повторити
// KEEP_ASPECT_COVERED, яким тягнеться Photo, і покласти маску рівно на неї —
// той самий перенос, що й MainMenu.cover_map() робить для вогню й диму.
uniform float image_aspect = 1.79297;

uniform float strength : hint_range(0.0, 2.0) = 1.0;
// Розмір комірки поля крапель у частках ВИСОТИ картини: одна крапля на
// комірку за цикл. Менше — щільніший дощ.
uniform float cell_size : hint_range(0.01, 0.2) = 0.034;
// Комірки сплюснуті так само, як кільця: квадратна сітка при сильній
// перспективі лишає порожні горизонтальні смуги між рядами крапель, бо кільце
// вкриває лише третину висоти своєї комірки.
uniform float grid_squash : hint_range(0.05, 1.0) = 0.35;
// Скільки секунд між ударами в комірці БЛИЗЬКОГО плану.
uniform float drop_period : hint_range(0.2, 6.0) = 2.0;
// Скільки секунд живе одна брижа — В СЕКУНДАХ, а не часткою періоду, і
// однаково на всій картині. Це принципово: коли тривалість була часткою
// періоду, а період удалині коротший (far_rate), далекі кільця й народжувались
// частіше, І прожовували все життя вдвічі з половиною швидше. На екрані це
// читалось як прискорена перемотка на задньому плані при нормальному
// передньому. Тепер темп однаковий скрізь, а перспектива лишається в тому, що
// далеке кільце проходить меншу екранну відстань за той самий час.
// МУСИТЬ бути не більшим за найкоротший період (drop_period * far_rate),
// інакше далека комірка ніколи не порожніє і кільце обрізається на льоту.
uniform float ring_life : hint_range(0.1, 3.0) = 0.95;
uniform float max_radius : hint_range(0.002, 0.08) = 0.038;
uniform float ring_count : hint_range(1.0, 8.0) = 3.0;
uniform float train_falloff : hint_range(0.5, 6.0) = 2.0;

// Горизонт на картині: нижче нього — земля. Вище крапель не буває.
uniform float horizon_v = 0.42;
// Сплюснутість кільця біля горизонту й біля нижнього краю кадру. Далекий
// край НЕ доводимо до геометрично точного (там було б ~0.15): нижче ~0.28
// кільце стає тоншим за піксель по вертикалі й просто зникає.
uniform float squash_far : hint_range(0.05, 1.0) = 0.30;
uniform float squash_near : hint_range(0.05, 1.0) = 0.50;
// Масштаб кільця там само: чим далі калюжа, тим ДРІБНІШІ на ній кола.
uniform float scale_far : hint_range(0.1, 1.0) = 0.34;
// У скільки разів коротший період ударів біля горизонту (див. fragment()).
uniform float far_rate : hint_range(0.1, 1.0) = 0.80;

uniform float spec_gain : hint_range(0.0, 8.0) = 3.2;
uniform float spec_clamp : hint_range(0.0, 1.0) = 0.50;
// Колір схилу, поверненого до неба, і колір протилежного. Підсвіт холодний і
// не яскравіший за саму хмару — небо тут важке й низьке, дзеркальних бліків
// воно не дає. Тінь чорна, бо калюжа й так темна: світліша тінь на ній просто
// не читається (перевірено — темний бік кільця зникав).
uniform vec3 sky_tint : source_color = vec3(0.62, 0.68, 0.76);
uniform vec3 shade_tint : source_color = vec3(0.0, 0.0, 0.0);
uniform float splash_gain : hint_range(0.0, 2.0) = 0.6;

float hash11(float p) {
	p = fract(p * 0.1031);
	p *= p + 33.33;
	p *= p + p;
	return fract(p);
}

vec2 hash22(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.xx + p3.yz) * p3.zy);
}

void fragment() {
	// Екран → координати КАРТИНИ під KEEP_ASPECT_COVERED (масштаб cover +
	// центроване обрізання). Маска намальована в системі картини, тож при
	// будь-якому аспекті вікна вона лишається на своїх калюжах.
	vec2 win = 1.0 / SCREEN_PIXEL_SIZE;
	float win_aspect = win.x / win.y;
	vec2 disp = win_aspect > image_aspect
		? vec2(win.x, win.x / image_aspect)
		: vec2(win.y * image_aspect, win.y);
	vec2 image_uv = (SCREEN_UV * win - (win - disp) * 0.5) / disp;

	float mask = texture(puddle_mask, image_uv).r;
	// Води тут немає — поле крапель не рахується взагалі.
	// Порахувати по самому ассету (а не на око): при цьому порозі малюється
	// 12.2% кадру, решта відсікається. Поріг низький навмисно — при масці 0.05
	// альфа ще ~0.16, тобто видима, тож піднімати його не можна: зникне
	// облямівка калюж. Розподіл, якщо колись знадобиться: 0.02 → 9.7%,
	// 0.05 → 7.4%, 0.08 → 5.6%.
	if (mask < 0.004) {
		discard;
	}

	// Квадратні одиниці: 1.0 = висота картини (щоб коло було колом, а не
	// розтягнутим по ширині кадру).
	vec2 p = vec2(image_uv.x * image_aspect, image_uv.y);

	vec2 cell_uv = vec2(p.x, p.y / grid_squash) / cell_size;
	vec2 cell_id = floor(cell_uv);
	vec2 cell_f = fract(cell_uv);

	// Тільки вертикальна складова нахилу: горизонтальна ні на що не впливає,
	// бо світло приходить згори (див. накопичення нижче).
	float slope_y = 0.0;
	float splash = 0.0;

	// Вікно перебору 5 комірок завширшки й 7 рядків заввишки — НЕ 3x3, і це не
	// запас «про всяк випадок». Піксель має перебрати всі комірки, чиє кільце
	// може його накрити, інакше кільце обрізається рівно по межі вікна, і на
	// екрані з'являється прямий відріз, що вмикається й гасне разом із кільцем.
	//
	// Арифметика (найбільший калібр 1.55, squash_near 0.5, значення за
	// замовчуванням): кільце тягнеться на
	//     по X: 1.55*max_radius/cell_size            = 1.71 комірки
	//     по Y: 1.55*max_radius*squash/(cell_size*grid_squash) = 2.42 рядка
	// а вікно ±k гарантує покриття лише (k - 0.2) комірки, бо крапля може
	// стояти на 1.2 комірки від свого початку (розкид нижче). Звідси
	// kx = 2 (1.8 >= 1.71) і ky = 3 (2.8 >= 2.42).
	//
	// Заміряно портом шейдера в numpy проти свідомо ширшого вікна: при 3x3
	// похибка сягала 1.00 при стелі ефекту 0.50, а стрибок на межі комірки —
	// рівно 0.50 за один рядок (найгірше на ближніх калюжах, v 0.82 і 0.95;
	// далекі були чисті). При 5x7 похибка нульова.
	//
	// Якщо колись міняти max_radius, cell_size, grid_squash або стелю каліберу
	// — перерахувати ці два числа. Зменшити вікно можна лише зменшивши кільце
	// відносно комірки, а це або дрібніші брижі, або рідший дощ.
	for (int j = -3; j <= 3; j++) {
		for (int i = -2; i <= 2; i++) {
			vec2 id = cell_id + vec2(float(i), float(j));

			// Глибину беремо з РЯДКА комірки, а не з випадкової точки краплі:
			// точка залежить від номера циклу, а номер циклу — від періоду,
			// який сам залежить від глибини. Різниця в межах комірки менша за
			// піксель, зате немає циклічної залежності.
			float cell_v = (id.y + 0.5) * cell_size * grid_squash;
			if (cell_v < horizon_v) {
				continue;  // вище горизонту землі немає
			}
			float near = smoothstep(horizon_v, 1.0, cell_v);

			// Далека комірка вкриває набагато більший шмат реальної землі, ніж
			// ближня того самого розміру на екрані — тож одна крапля на цикл
			// там читається як рідкий дощ. Компенсуємо коротшим періодом.
			// Це впливає ЛИШЕ на частоту крапель, не на швидкість брижі.
			float period = drop_period * mix(far_rate, 1.0, near);
			// Фаза комірки: кожна крапає у свій момент, інакше весь дощ б'є в такт.
			float cycle = TIME / period + hash22(id * 0.137 + 7.3).x;
			// Вік — у СЕКУНДАХ від удару, поділених на життя брижі. Саме тому
			// темп однаковий і спереду, і вдалині (див. коментар до ring_life).
			// min() тут — примус того інваріанта, що описаний у ring_life:
			// hint_range дозволяє виставити життя довшим за період, і тоді
			// комірка ніколи не порожніє, а кільце обрізається на льоту без
			// жодного натяку чому. Дешевше примусити, ніж лишити пасткою.
			float age = fract(cycle) * period / min(ring_life, period);
			if (age > 1.0) {
				continue;  // комірка між краплями — порожня вода
			}

			// Нова випадкова точка удару щоцикл (номер циклу — у ключі хешу).
			// Номер згортаємо по модулю: TIME росте до години, і без mod ключ
			// хеша доповз би до шестизначних чисел — у mediump це просто
			// переповнення, а патерн крапель зіпсувався б задовго до того.
			// 64 варіанти на комірку — це 64 періоди, тобто ~100-130 с
			// (період 1.6-2.0 с), оком такий повтор не ловиться.
			float spawn = mod(floor(cycle), 64.0);
			// Діапазон ширший за комірку (-0.2..1.2), щоб краплі заходили на
			// сусідні: рівно по одній на комірку — це видима ґратка, а не дощ.
			// Верхня межа 1.2 закладена в розрахунок вікна перебору вище —
			// збільшити її можна лише разом із вікном.
			vec2 rnd = hash22(id + spawn * 17.0) * 1.4 - 0.2;
			// Зсув «крапля мінус піксель» рахуємо в сітці, потім повертаємо в
			// одиниці картини (сітка стиснута по y на grid_squash).
			vec2 in_grid = (vec2(float(i), float(j)) + rnd - cell_f) * cell_size;
			vec2 drop = vec2(in_grid.x, in_grid.y * grid_squash);

			float squash = mix(squash_far, squash_near, near);
			// Краплі різного калібру: без цього розкиду всі кола однакові й
			// поверхня читається як візерунок у горошок, а не як дощ.
			// Розкид виводимо з уже порахованого rnd — ще один хеш тут зайвий.
			float caliber = 0.45 + 1.1 * hash11(rnd.x * 2.3 + rnd.y * 5.7 + 1.0);
			float scale = mix(scale_far, 1.0, near) * caliber;

			// Відстань в еліптичній метриці: по вертикалі рахується сильніше,
			// тож коло сталого радіуса виходить сплюснутим еліпсом.
			vec2 e = vec2(-drop.x, -drop.y / squash);
			float r = length(e) / scale;

			// Фронт хвилі біжить назовні; позаду нього — цуг кілець, що згасає
			// вглиб. u — відстань за фронтом.
			float u = age * max_radius - r;
			if (u < 0.0) {
				continue;  // попереду фронту вода ще спокійна
			}
			float freq = ring_count * TAU / max_radius;
			// Удалині цуг згортається до ОДНОГО кільця. Кілька кілець там
			// займали б менше пікселя по вертикалі (сплющення + дрібний
			// масштаб), світлі й темні смуги гасили б одна одну, і далека
			// калюжа виглядала б мертвою — перевірено на скріншотах.
			float decay = mix(train_falloff * 1.8, train_falloff, near) / max_radius;
			// Кільце тримає силу, поки росте, і гасне лише під кінець життя.
			// Згасання від самого народження (напр. (1-age)^2) вбиває його
			// РІВНО тоді, коли воно доростає до повного розміру — на екрані
			// лишаються самі зародки на кілька пікселів.
			float envelope = exp(-u * decay) * (1.0 - smoothstep(0.5, 1.0, age));

			// Похідна висоти по радіусу = нахил поверхні. Напрямок беремо
			// НЕсплюснутий: перспектива стискає екранний слід кільця, але не
			// сам нахил води — схил, повернутий до неба, повернутий до нього
			// однаково і зблизька, і здалеку. Множення тут на squash займало
			// втричі яскравості й робило брижі невидимими.
			// Потрібна лише y-складова: горизонтальний нахил не змінює,
			// скільки неба ловить схил, тож x не рахуємо взагалі.
			slope_y += (e.y / max(length(e), 1e-4)) * cos(u * freq) * envelope;

			// Коротка яскрава цятка в місці удару.
			splash += exp(-r * r * 9000.0) * exp(-age * 22.0);
		}
	}

	// Окремої «дрібної брижі» між ударами тут НЕМАЄ навмисно: будь-який
	// добуток двох синусів дає регулярну сітку-шотландку, яка на екрані
	// читається як тканина, а не як вода, і топить самі кільця. Живу
	// поверхню дає щільність крапель — саме так це й працює насправді.
	slope_y *= strength * mask;

	// Знак = у який бік нахилений схил: до неба (світлішає) чи від нього.
	// Стеля потрібна, бо без неї щільне накладання кілець вибілює калюжу в
	// суцільну пляму — вода під важким небом дзеркальних відблисків не дає.
	float light = clamp(slope_y * spec_gain, -spec_clamp, spec_clamp)
		+ splash * splash_gain * strength * mask;

	// Малюємо двома тонами з альфою |light| замість додавання до кадру:
	// від'ємне додавання неможливе без читання екрана (кадровий буфер обріже
	// його до нуля), а темний бік кільця потрібен — без нього лишаються самі
	// світлі дуги й вода читається як накладені наклейки.
	COLOR = vec4(light >= 0.0 ? sky_tint : shade_tint, min(abs(light), 1.0));
}
