class_name BoardWarmUp
extends RefCounted
## Об'їзд дошки за гейтом передачі. Варіант матеріалу, який уперше потрапляє в кадр посеред
## першого скролу, компілюється саме там (на телефоні це кадр у сотні мс). Тож, поки гейт ще
## закриває екран, камера по одному кадру стоїть над кожним блоком дошки: усе, що гравець
## побачить, уже намальоване хоч раз. Тут лише список точок; камеру й юнітів під гейтом веде
## BattleScreen._warm_board (міни, шрами, дахи й ліс гравця вже стоять, юніти ставляться й прибираються).

## Сторона блоку в клітинках: менша за видиму камерою ділянку на типовому зумі, тож блоки перекриваються.
const STEP: int = 8


## Центри блоків STEP×STEP, що вкривають дошку, рядок за рядком. Останній блок може бути неповним, тоді
## центр притиснуто до краю дошки.
static func stops(size: Vector2i, step: int = STEP) -> Array[Vector2i]:
	var out: Array[Vector2i] = []
	for y in range(0, size.y, step):
		for x in range(0, size.x, step):
			out.append(Vector2i(mini(x + step / 2, size.x - 1), mini(y + step / 2, size.y - 1)))
	return out
