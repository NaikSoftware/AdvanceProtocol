; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Advance Protocol"
run/main_scene="res://game/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
run/low_processor_mode=true

[autoload]

SettingsService="*res://game/autoload/settings_service.gd"
MatchService="*res://game/autoload/match_service.gd"
SceneRouter="*res://game/autoload/scene_router.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

[input_devices]

pointing/emulate_mouse_from_touch=false

[internationalization]

locale/translations=PackedStringArray("res://assets/i18n/strings.uk.translation", "res://assets/i18n/strings.en.translation")

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=2
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1

[shader_globals]

weather_wetness={
"type": "float",
"value": 0.0
}
cloud_shadow_strength={
"type": "float",
"value": 0.0
}
sky_reflection_gain={
"type": "float",
"value": 1.0
}
fog_time={
"type": "float",
"value": 0.0
}
sun_dir={
"type": "vec3",
"value": Vector3(0.5, 0.7071, 0.5)
}
sky_clear={
"type": "float",
"value": 0.0
}
foliage_tint={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
water_murk={
"type": "float",
"value": 0.0
}
water_wind={
"type": "float",
"value": 1.0
}
unit_contact_shadow={
"type": "float",
"value": 0.0
}
haze_color={
"type": "vec3",
"value": Vector3(0.1, 0.135, 0.155)
}
